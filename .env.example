# Database connection URL
# Format: postgres://username:password@host:port/databaseName?schema=schemaName
DATABASE_URL="postgres://login:password@localhost:5432/dbName?schema=public"

# Server port
# Example: 3499
PORT=3499

# Bcrypt salt rounds for password hashing
# Recommended: 10-12
SALT_ROUNDS=12

# Secret key for JWT tokens
# Should be long and random
JWT_SECRET="your_very_strong_secret_key_here"

# CORS allowed origins (comma-separated for multiple origins)
# Example: "http://localhost:3000,https://example.com"
CORS_ALLOWED_ORIGIN="http://localhost:3000"

# Secret key for Cookies
# Should be long and random
COOKIE_SECRET="your_very_strong_secret_key_here"

# Public API key from Mailjet
MAILJET_API_KEY="your_mailjet_api_key_here"

# Private API secret key from Mailjet
MAILJET_SECRET_KEY="your_mailjet_secret_key_here"

# Default sender email address (must be verified in Mailjet)
# Example: "no-reply@yourdomain.com" or "support@yourdomain.com"
MAILJET_SENDER_EMAIL="your_verified_sender_email@domain.com"

# Redis connection URL
REDIS_CONNECT="redis://username:password@localhost:6379"